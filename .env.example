# Runtime paths (all default to directories beside this repository)
MODZ_BASE_DIR=.
UPLOAD_DIRECTORY=uploads
PROCESSING_DIRECTORY=processing
OUTPUT_DIRECTORY=output
PROJECT_DIRECTORY=projects
LOG_DIRECTORY=logs
DATABASE_PATH=server.db

# External tools; use absolute paths on the Linux server when needed.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MESHROOM_PATH=meshroom
BLENDER_PATH=blender
# Photogrammetry backend for the "meshroom" pipeline stage:
#   engine    (default) CPU-only reconstruction engine, no CUDA required
#   external  invoke the configured Meshroom/AliceVision executable
MESHROOM_BACKEND=engine

# Dense reconstruction tuning (engine defaults are already dense-friendly:
# medium preset, 0.3 s frame interval, 5-frame match window, 6 dense
# neighbours, 600 px sweep, 448-voxel mesh, weight >= 5 views).
# Uncomment for maximum coverage (slower, more RAM):
# RECON_QUALITY=dense
# RECON_FRAME_INTERVAL=0.25
# RECON_MAX_FRAMES=400
# RECON_MATCH_WINDOW=5
# RECON_DENSE_MAX_SIZE=600
# RECON_DENSE_MAX_PLANES=200
# RECON_DENSE_MIN_NCC=0.25
# RECON_MESH_RESOLUTION=448
# RECON_MESH_MIN_WEIGHT=5

# Good-source verification gate (backend/utils/source_check.py): the Video
# Validation stage blocks clips that cannot cover a full orbit.  Relax only
# if you accept partial models.
# SOURCE_MIN_DURATION_S=10
# SOURCE_MIN_WIDTH=1280
# SOURCE_MIN_HEIGHT=720
# SOURCE_MIN_FPS=24
# SOURCE_MIN_VIDEO_MB=5
# SOURCE_MIN_IMAGES=8
# SOURCE_SAMPLE_FRAMES=12
# SOURCE_MIN_SHARP_PASS_RATE=0.6

# Single-user resource limits.
MAX_CONCURRENT_JOBS=1
MAX_UPLOAD_BYTES=2147483648
MAX_PROJECT_STORAGE_BYTES=21474836480
MAX_PROJECT_FILES=100
MAX_EXPORT_BYTES=8589934592
COMMAND_TIMEOUT_SECONDS=3600
REQUIRE_EXTERNAL_TOOLS=false
# Set a long random value before binding beyond localhost; clients send X-API-Token or Bearer auth.
API_TOKEN=
# Leave HOST blank for automatic non-loopback detection, or set an explicit interface/address.
HOST=
PORT=8002
# Comma-separated origins allowed to call the API; same-origin UI needs no CORS.
CORS_ORIGINS=http://localhost:8002,http://127.0.0.1:8002,http://localhost:8080,http://127.0.0.1:8080

# AI advisor (read-only, local Ollama; pipeline never calls it).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
ADVISOR_ENABLED=1

# Background masking (engine stage between frame selection and features).
# Small/general projects mask by default; vehicles skip unless enabled.
MASK_BACKGROUND=1
MASK_BACKEND=auto
MASK_MODEL=u2netp
