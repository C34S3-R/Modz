#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ -n "${PYTHON_BIN:-}" ]]; then
  PYTHON="$PYTHON_BIN"
elif [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
  PYTHON="$ROOT_DIR/.venv/bin/python"
else
  PYTHON="python3"
fi

# Default to localhost (127.0.0.1): the tool runs on whichever machine needs
# it and serves that machine only, so whoever starts it - you, or someone on
# their own laptop - opens http://localhost:<port> locally and the pipeline
# runs right there.  Network exposure is a deliberate, explicit opt-in (below),
# never the default, which also keeps the unauthenticated admin/file APIs off
# the network unless you ask for it.
#
#   HOST=<unset>    localhost - this machine only (default)
#   HOST=0.0.0.0    every interface (LAN + tailnet + ...)
#   HOST=<ip>       one specific address
#   HOST=auto       prefer Tailscale (100.*) when present, else the LAN address
#   HOST=loopback   this machine only - 127.0.0.1 (same as the default)
case "${HOST:-}" in
  "") HOST="127.0.0.1" ;;
  loopback) HOST="127.0.0.1" ;;
  auto)
    HOST=""
    for addr in $(hostname -I 2>/dev/null); do
      case "$addr" in 100.*) HOST="$addr"; break ;; esac
    done
    if [[ -z "$HOST" ]]; then
      for addr in $(hostname -I 2>/dev/null); do
        case "$addr" in
          127.*|::1) ;;
          *) HOST="$addr"; break ;;
        esac
      done
    fi
    HOST="${HOST:-0.0.0.0}"
    ;;
esac

if ! "$PYTHON" -c 'import fastapi, multipart, uvicorn' >/dev/null 2>&1; then
  cat >&2 <<EOF
Backend dependencies are missing for: $PYTHON
Install them with:
  python3 -m venv .venv
  . .venv/bin/activate
  python -m pip install -r requirements.txt
EOF
  exit 1
fi

export PYTHONPATH="$ROOT_DIR/backend${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1
PORT="${PORT:-8002}"
printf 'Starting vehicle server at http://%s:%s\n' "$HOST" "$PORT" >&2
exec "$PYTHON" -m uvicorn main:app \
  --host "$HOST" \
  --port "$PORT" \
  "$@"
