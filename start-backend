#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

if [[ -n "${PYTHON_BIN:-}" ]]; then
  PYTHON="$PYTHON_BIN"
elif [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
  PYTHON="$ROOT_DIR/.venv/bin/python"
else
  PYTHON="python3"
fi

# Default to this machine's own address. Modz runs on whichever box is doing
# the processing, so it should advertise that box - a routable address on it
# that the same machine and anything else on its LAN can reach. Not loopback
# (which locks every other device out), and not a synthesized overlay address
# such as Tailscale's 100.x, which only tailnet peers can reach and which is
# meaningless on somebody else's laptop.
#
#   HOST=<unset>    this machine's own non-loopback address (default)
#   HOST=loopback   this machine only - 127.0.0.1
#   HOST=auto       old behaviour: prefer Tailscale (100.*) when present
#   HOST=0.0.0.0    every interface
#   HOST=<ip>       one specific address
own_address() {
  local addr
  for addr in $(hostname -I 2>/dev/null); do
    case "$addr" in
      127.*|::1|100.*) ;;
      *) printf '%s' "$addr"; return 0 ;;
    esac
  done
  # No LAN address (offline, or interface still coming up): take the tailnet
  # address rather than nothing, so the box is still reachable remotely.
  for addr in $(hostname -I 2>/dev/null); do
    case "$addr" in
      100.*) printf '%s' "$addr"; return 0 ;;
    esac
  done
  printf '127.0.0.1'
}

case "${HOST:-}" in
  "") HOST="$(own_address)" ;;
  loopback) HOST="127.0.0.1" ;;
  auto)
    HOST=""
    for addr in $(hostname -I 2>/dev/null); do
      case "$addr" in 100.*) HOST="$addr"; break ;; esac
    done
    if [[ -z "$HOST" ]]; then
      for addr in $(hostname -I 2>/dev/null); do
        case "$addr" in
          127.*|::1) ;;
          *) HOST="$addr"; break ;;
        esac
      done
    fi
    HOST="${HOST:-0.0.0.0}"
    ;;
esac

if ! "$PYTHON" -c 'import fastapi, multipart, uvicorn' >/dev/null 2>&1; then
  cat >&2 <<EOF
Backend dependencies are missing for: $PYTHON
Install them with:
  python3 -m venv .venv
  . .venv/bin/activate
  python -m pip install -r requirements.txt
EOF
  exit 1
fi

export PYTHONPATH="$ROOT_DIR/backend${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1
PORT="${PORT:-8002}"
printf 'Starting vehicle server at http://%s:%s\n' "$HOST" "$PORT" >&2
exec "$PYTHON" -m uvicorn main:app \
  --host "$HOST" \
  --port "$PORT" \
  "$@"
